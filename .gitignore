.env
__pycache__/
*.pyc
.venv/
.cache/
.DS_Store
.pytest_cache/
.ruff_cache/
.claude/
.worktrees/
.coverage
tasks/
*.lock
docs/superpowers/

# Repology HTML scrape cache — regenerable, never commit (parsed output is project-urls.csv)
data/sources/repology/html-cache/

# ecosyste.ms criticality raw package cache (regenerable; audit copy is local)
data/sources/ecosystems/raw/criticality/

# Scratch + transient full vendor dumps; never commit
tmp/

# ecosyste.ms per-package API cache — regenerable (90-day TTL, refetched by
# src.sources.ecosystems.packages). No builder reads it; the derived index
# data/sources/ecosystems/<eco>/packages.csv stays tracked.
data/sources/ecosystems/*/raw/

# PyPI per-package API cache — regenerable (refetched by
# src.sources.pypi.fetch_pypi_urls). No builder reads it; the derived
# data/sources/pypi/raw/package-urls.csv stays tracked.
data/sources/pypi/raw/api-cache/

# crates db-dump slim extracts — regenerable via fetch_db_dump (~560 MB); never commit
data/sources/crates/db-dump

# Excel lock files (workbook open in Excel)
data/preview/~$*.xlsx

# Ad-hoc review notes over the preview table; not a pipeline output
data/preview/board-preview-report.md
data/preview/board-preview-report.pdf

# Logo assets for reports/decks — fetched from upstream brand pages, not a pipeline output
logos/

# crates per-crate annual download aggregate — regenerable from the monthly
# CSVs + db-dump extracts in seconds; never commit
data/sources/crates/download-cache/
